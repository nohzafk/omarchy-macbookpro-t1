--- /tmp/tb-pristine/apple-ibridge.c
+++ ./apple-ibridge.c
@@ -208,6 +208,16 @@ int apple_ib_set_tb_mode(struct usb_device *udev, enum tb_mode mode)
 
 	mutex_lock(&appleib_tbmode_lock);
 
+	/* FIX 2 (local): changing configuration tears down the HID interface that is
+	 * currently being probed. Doing that synchronously deadlocks first on this
+	 * driver's mode lock and, if that lock is dropped, on driver-core device locks:
+	 *
+	 *   INFO: task modprobe:24033 blocked for more than 983 seconds.
+	 *   task:(udev-worker) state:D ... device_del ... usb_set_configuration
+	 *
+	 * usb_driver_set_configuration() is the USB core helper for this exact case. It
+	 * queues the change on a work thread so the probe path can release its locks.
+	 */
 	if (mode == TB_MODE_AUTO)
 		mode = appleib_parse_tb_mode_param();
 
@@ -236,15 +246,13 @@ int apple_ib_set_tb_mode(struct usb_device *udev, enum tb_mode mode)
 		goto out_unlock;
 	}
 
-	dev_info(&udev->dev, "MBP14,3: switching Touch Bar to cfg=%d (%s)\n",
+	dev_info(&udev->dev, "MBP14,3: queueing Touch Bar switch to cfg=%d (%s)\n",
 		 target_cv, (target_cv == dcv) ? "display" : "keyboard");
 
-	ret = usb_set_configuration(udev, target_cv);
+	ret = usb_driver_set_configuration(udev, target_cv);
 	if (ret)
-		dev_err(&udev->dev, "MBP14,3: usb_set_configuration(%d) failed: %d\n",
+		dev_err(&udev->dev, "MBP14,3: failed to queue configuration %d: %d\n",
 			target_cv, ret);
-	else
-		msleep(150); /* let udev settle */
 
 out_unlock:
 	mutex_unlock(&appleib_tbmode_lock);
